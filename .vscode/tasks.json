{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CycleFlow: Start",
      "type": "npm",
      "script": "dev",
      "path": "cycleflow",
      "group": "build",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": false
      },
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Local:|Network:|ready in \\d+ ms)"
        }
      }
    },
    {
      "label": "CycleFlow: Stop",
      "type": "shell",
      "command": "npm run stop",
      "options": {
        "cwd": "${workspaceFolder}/cycleflow",
        "env": { "DEV_PORT": "5173" }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "CycleFlow: Clear cache",
      "type": "npm",
      "script": "clear-cache",
      "path": "cycleflow",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "CycleFlow: Check",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python scripts/check.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    }
  ]
}
